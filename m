-int compare_vip(void *data1, void *data2)
-{
-	return ( !memcmp( data1 + 4, data2 + 4, 4 ) );
-}
-
-int choose_wip(void *data, int32_t size)
-{
-	unsigned char *key= data;
-	uint32_t hash = 0;
-	size_t i;
-
-	for (i = 0; i < 4; i++) {
-		hash += key[i];
-		hash += (hash << 10);
-		hash ^= (hash >> 6);
-	}
-
-	hash += (hash << 3);
-	hash ^= (hash >> 11);
-	hash += (hash << 15);
-
-	return (hash%size);
-
-}
-
-int choose_vip(void *data, int32_t size)
-{
-	unsigned char *key= data;
-	uint32_t hash = 0;
-	size_t i;
-	for (i = 4; i < 8; i++) {
-		hash += key[i];
-		hash += (hash << 10);
-		hash ^= (hash >> 6);
-	}
-
-	hash += (hash << 3);
-	hash ^= (hash >> 11);
-	hash += (hash << 15);
-
-	return (hash%size);
-
-}
